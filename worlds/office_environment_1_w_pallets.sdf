<?xml version="1.0"?>
<sdf version="1.7">
  <world name="office_environment_1_w_pallets">
    <atmosphere type="adiabatic" />
    <gravity>0 0 -9.8</gravity>
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>false</shadows>
      <grid>true</grid>
      <origin_visual>true</origin_visual>
    </scene>

    <physics name="dart_physics" default="true" type="ignored">
      <max_step_size>0.002</max_step_size>
      <real_time_update_rate>500</real_time_update_rate>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!--
      Load the standard Gazebo world systems used by the maintained worlds in
      this package. This world keeps the same base plugin set as
      `factory_w_pallets.sdf`.
    -->
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics">
      <engine>
        <filename>gz-physics-dartsim-plugin</filename>
      </engine>
    </plugin>
    <plugin filename="gz-sim-contact-system" name="gz::sim::systems::Contact" />
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light name="sun" type="directional">
      <cast_shadows>1</cast_shadows>
      <pose>0 0 10 0 -0.5 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <pose>0 0 0 0 0 0</pose>
          <material>
            <ambient>0.4 0.4 0.4 1</ambient>
            <diffuse>0.4 0.4 0.4 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
          <cast_shadows>0</cast_shadows>
        </visual>
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
          <pose>0 0 0 0 0 0</pose>
          <surface>
            <friction>
              <ode />
              <torsional>
                <ode />
              </torsional>
            </friction>
            <bounce />
            <contact />
          </surface>
        </collision>
        <pose>0 0 0 0 0 0</pose>
      </link>
      <pose>0 0 0 0 0 0</pose>
    </model>

    <!--
      The office walls are provided by one STL mesh. The same mesh is used for
      both `visual` and `collision` so Gazebo renders and collides against the
      same geometry.
    -->
    <model name="office_environment_1">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <geometry>
            <mesh>
              <uri>package://ros_gz_tools/meshes/office_environment_1/office_environment_1.stl</uri>
            </mesh>
          </geometry>
          <material>
            <ambient>0.6 0.6 0.6 1</ambient>
            <diffuse>0.6 0.6 0.6 1</diffuse>
          </material>
        </visual>
        <collision name="collision">
          <geometry>
            <mesh>
              <uri>package://ros_gz_tools/meshes/office_environment_1/office_environment_1.stl</uri>
            </mesh>
          </geometry>
        </collision>
      </link>
      <pose relative_to="ground_plane">0 0 0 0 0 0</pose>
    </model>

    <!--
      These pallet instances are added with `<include>` so the world keeps one
      reusable model definition and only stores the per-instance poses here.
    -->
    <include>
      <uri>model://euro_pallet_w_stacked_boxes</uri>
      <pose relative_to="ground_plane">-12.624345970850529 8.545947400993088 0 0 0 0</pose>
      <name>euro_pallet_w_stacked_boxes_1</name>
    </include>

    <include>
      <uri>model://euro_pallet_w_stacked_boxes</uri>
      <pose relative_to="ground_plane">-11.051199913024902 8.519840240478516 0 0 0 -1.5474915183304312</pose>
      <name>euro_pallet_w_stacked_boxes_2</name>
    </include>

    <include>
      <uri>model://euro_pallet_w_boxes</uri>
      <pose relative_to="ground_plane">-12.583259223510218 7.52204364595089 0 0 0 0</pose>
      <name>euro_pallet_w_boxes_1</name>
    </include>

    <include>
      <uri>model://euro_pallet_w_boxes</uri>
      <pose relative_to="ground_plane">-9.586601643481009 8.427691803739954 0 0 0 0</pose>
      <name>euro_pallet_w_boxes_2</name>
    </include>

    <include>
      <uri>model://euro_pallet_w_stacked_boxes</uri>
      <pose relative_to="ground_plane">-7.788374708250269 8.413746986204199 0 0 0 0</pose>
      <name>euro_pallet_w_stacked_boxes_3</name>
    </include>
  </world>
</sdf>
