<?xml version="1.0"?>
<sdf version="1.7">
    <!--
    Model: euro_pallet.
    A single rigid body (one link) that represents a Euro-pallet (EN 13698-1 dimensions).
    Collision elements are boxed primitives for efficiency.
    Friction / contact parameters are added only where they can interact with external bodies.
    -->
    <model name="euro_pallet" canonical_link="link" placement_frame="link">
        <static>false</static>
        <link name="link">
            <!--
            Avoid self-collision between the five collision geometries
            inside this link. Default is false, but set explicitly
            to document the intention.
            -->
            <self_collide>false</self_collide>

            <visual name="visual">
                <geometry>
                    <mesh>
                        <uri>model://euro_pallet/meshes/euro_pallet.dae</uri>
                        <scale>1 1 1</scale>
                    </mesh>
                </geometry>
                <!--
                Link of the mesh is at the center of the bottom face of the pallet.
                -->
                <pose>0 0 0 0 0 0</pose>
            </visual>

            <collision name="pallet_top_collision">
                <geometry>
                    <box>
                        <size>1.20 0.8 0.044</size>
                    </box>
                </geometry>
                <pose>0 0 0.122 0 0 0</pose>
            </collision>

            <collision name="pallet_center_collision">
                <geometry>
                    <box>
                        <size>1.20 0.145 0.1</size>
                    </box>
                </geometry>
                <pose>0 0 0.05 0 0 0</pose>
            </collision>

            <collision name="pallet_left_collision">
                <geometry>
                    <box>
                        <size>1.20 0.1 0.1</size>
                    </box>
                </geometry>
                <pose>0 0.35 0.05 0 0 0</pose>
            </collision>

            <collision name="pallet_right_collision">
                <geometry>
                    <box>
                        <size>1.20 0.1 0.1</size>
                    </box>
                </geometry>
                <pose>0 -0.35 0.05 0 0 0</pose>
            </collision>

            <inertial>
                <!--
                <mass>25.0</mass>
                <inertia>
                    <ixx>1.3765</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>3.0432</iyy>
                    <iyz>0.0</iyz>
                    <izz>4.3333</izz>
                </inertia>
                -->
                <mass>0.1</mass>
                <inertia>
                    <ixx>0.005506133</ixx>
                    <ixy>0.000000000</ixy>
                    <ixz>0.000000000</ixz>
                    <iyy>0.012172800</iyy>
                    <iyz>0.000000000</iyz>
                    <izz>0.017333333</izz>
                </inertia>
                <!--
                z = whole_body.size_z/2 = 0.144/2 = 0.072 m.
                -->
                <pose>0 0 0.072 0 0 0</pose>
            </inertial>
        </link>
    </model>
</sdf>
