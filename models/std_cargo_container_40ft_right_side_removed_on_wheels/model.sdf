<?xml version="1.0"?>
<sdf version="1.7">
    <!--
    Outer dimensions of a standard 40ft cargo container (size_x = 12.19 m, size_y = 2.336 m, size_z = 2.413 m) and
    inner dimensions (size_x = 12.01 m, size_y = 2.33 m, size_z = 2.38 m).
    The container is mounted on a chassis structure that provides mechanical support and interfaces with the ground via
    four wheels (two axles).
    Frame for the model is footprint_link, located at the center of bottom face of the payload_chassis, on the ground.
    -->
    <model name="std_cargo_container_40ft_right_side_removed_on_wheels" canonical_link="footprint_link" placement_frame="footprint_link">
        <static>false</static>
        <self_collide>false</self_collide>

        <link name="footprint_link">
            <inertial>
                <mass>0.001</mass>
                <inertia>
                    <ixx>1e-6</ixx>
                    <ixy>0</ixy>
                    <ixz>0</ixz>
                    <iyy>1e-6</iyy>
                    <iyz>0</iyz>
                    <izz>1e-6</izz>
                </inertia>
            </inertial>
        </link>

        <!--
        The link for the payload_chassis is at the center of the bottom face of the payload chassis.
        -->
        <link name="payload_chassis_link">
            <visual name="visual">
                <geometry>
                    <box>
                        <size>12.19 2.336 0.17</size>
                    </box>
                </geometry>
                <pose>0 0 0.085 0 0 0</pose>
                <material>
                    <ambient>0 0 0 1</ambient>
                    <diffuse>0 0 0 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
            </visual>

            <collision name="collision">
                <geometry>
                    <box>
                        <size>12.19 2.336 0.17</size>
                    </box>
                </geometry>
                <pose>0 0 0.085 0 0 0</pose>
            </collision>

            <inertial>
                <mass>2800.0</mass>
                <inertia>
                    <ixx>1279.685</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>34678.405</iyy>
                    <iyz>0.0</iyz>
                    <izz>35945.605</izz>
                </inertia>
                <pose>0 0 0.085 0 0 0</pose>
            </inertial>

            <!--
            z = 2 * wheel_radius = 2 * 0.5 = 1 m
            -->
            <pose relative_to="footprint_link">0 0 1.0 0 0 0</pose>
        </link>

        <joint name="payload_chassis_frame_joint" type="fixed">
            <parent>footprint_link</parent>
            <child>payload_chassis_link</child>
            <pose relative_to="footprint_link">0 0 1.0 0 0 0</pose>
        </joint>

        <!--
        The container_link is at the center of the bottom face of the container.
        -->
        <link name="container_link">
            <visual name="floor_visual">
                <geometry>
                    <box>
                        <size>12.19 2.336 0.03</size>
                    </box>
                </geometry>
                <pose>0 0 0.015 0 0 0</pose>
                <material>
                    <ambient>0.9 1.0 0.3 1</ambient>
                    <diffuse>0.9 1.0 0.3 1</diffuse>
                    <specular>0.3 0.3 0.1 1</specular>
                </material>
            </visual>

            <visual name="left_wall_visual">
                <geometry>
                    <box>
                        <size>12.19 0.003 2.38</size>
                    </box>
                </geometry>
                <pose>0 1.1665 1.22 0 0 0</pose>
                <material>
                    <ambient>0 1 0 1</ambient>
                    <diffuse>0 1 0 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>

            <visual name="ceiling_visual">
                <geometry>
                    <box>
                        <size>12.19 2.336 0.003</size>
                    </box>
                </geometry>
                <pose>0 0 2.4115 0 0 0</pose>
                <material>
                    <ambient>0 1 0 1</ambient>
                    <diffuse>0 1 0 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>

            <visual name="front_wall_visual">
                <geometry>
                    <box>
                        <size>0.09 2.33 2.38</size>
                    </box>
                </geometry>
                <pose>6.050 0 1.22 0 0 0</pose>
                <material>
                    <ambient>0 1 0 1</ambient>
                    <diffuse>0 1 0 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>

            <visual name="back_wall_visual">
                <geometry>
                    <box>
                        <size>0.09 2.33 2.38</size>
                    </box>
                </geometry>
                <pose>-6.050 0 1.22 0 0 0</pose>
                <material>
                    <ambient>0 1 0 1</ambient>
                    <diffuse>0 1 0 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>

            <collision name="floor_collision">
                <geometry>
                    <box>
                        <size>12.19 2.336 0.03</size>
                    </box>
                </geometry>
                <pose>0 0 0.015 0 0 0</pose>
            </collision>

            <collision name="left_wall_collision">
                <geometry>
                    <box>
                        <size>12.19 0.003 2.38</size>
                    </box>
                </geometry>
                <pose>0 1.1665 1.22 0 0 0</pose>
            </collision>

            <collision name="ceiling_collision">
                <geometry>
                    <box>
                        <size>12.19 2.336 0.003</size>
                    </box>
                </geometry>
                <pose>0 0 2.4115 0 0 0</pose>
            </collision>

            <collision name="front_wall_collision">
                <geometry>
                    <box>
                        <size>0.09 2.33 2.38</size>
                    </box>
                </geometry>
                <pose>6.050 0 1.22 0 0 0</pose>
            </collision>

            <collision name="back_wall_collision">
                <geometry>
                    <box>
                        <size>0.09 2.33 2.38</size>
                    </box>
                </geometry>
                <pose>-6.050 0 1.22 0 0 0</pose>
            </collision>

            <inertial>
                <mass>3701.0</mass>
                <inertia>
                    <ixx>3416.627</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>1750.107</iyy>
                    <iyz>0.0</iyz>
                    <izz>1676.303</izz>
                </inertia>
                <pose>0 0 1.2065 0 0 0</pose>
            </inertial>
            <pose relative_to="payload_chassis_link">0 0 0.17 0 0 0</pose>
        </link>

        <joint name="container_frame_joint" type="fixed">
            <parent>payload_chassis_link</parent>
            <child>container_link</child>
            <pose relative_to="payload_chassis_link">0 0 0.17 0 0 0</pose>
        </joint>

        <link name="front_left_landing_leg_link">
            <visual name="visual">
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>1</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.15 0.12 0.10 1</ambient>
                    <diffuse>0.15 0.12 0.10 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
                <pose>0 0 0.5 0 0 0</pose>
            </visual>

            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>1</length>
                    </cylinder>
                </geometry>
                <pose>0 0 0.5 0 0 0</pose>
            </collision>

            <inertial>
                <mass>120.0</mass>
                <inertia>
                    <ixx>40.3</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>40.3</iyy>
                    <iyz>0.0</iyz>
                    <izz>0.6</izz>
                </inertia>
                <pose>0 0 0.5 0 0 0</pose>
            </inertial>
            <!--
            x = payload_chassis.size_x/2 - front_landing_leg.radius - offset_x = 12.19/2 - 0.1 - 2 = 3.995 m
            y = payload_chassis.size_y/2 - front_landing_leg.radius - offset_y = 2.336/2 - 0.1 - 0.5 = 0.568 m
            z = -front_wheel.radius = -0.50 m
            -->
            <pose relative_to="payload_chassis_link">3.995 0.568 -1.0 0 0 0</pose>
        </link>

        <!--
        x = payload_chassis.size_x/2 - front_wheel.radius - offset = 12.19/2 - 0.50 - 1 = 4.595 m
        y = payload_chassis.size_y/2 - front_wheel.length/2 = 2.336/2 - 0.38/2 = 0.978 m
        z = -front_wheel.radius = -0.50 m
        -->
        <joint name="front_left_landing_leg_joint" type="fixed">
            <parent>payload_chassis_link</parent>
            <child>front_left_landing_leg_link</child>
            <pose relative_to="payload_chassis_link">3.995 0.568 -1.0 0 0 0</pose>
        </joint>

        <link name="front_right_landing_leg_link">
            <visual name="visual">
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>1</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0.15 0.12 0.10 1</ambient>
                    <diffuse>0.15 0.12 0.10 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
                <pose>0 0 0.5 0 0 0</pose>
            </visual>

            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius>0.1</radius>
                        <length>1</length>
                    </cylinder>
                </geometry>
                <pose>0 0 0.5 0 0 0</pose>
            </collision>

            <inertial>
                <mass>120.0</mass>
                <inertia>
                    <ixx>40.3</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>40.3</iyy>
                    <iyz>0.0</iyz>
                    <izz>0.6</izz>
                </inertia>
                <pose>0 0 0.5 0 0 0</pose>
            </inertial>
            <!--
            x = payload_chassis.size_x/2 - front_landing_leg.radius - offset_x = 12.19/2 - 0.1 - 2 = 3.995 m
            y = -payload_chassis.size_y/2 + front_landing_leg.radius + offset_y = -2.336/2 + 0.1 + 0.5 = -0.568 m
            z = -front_wheel.radius = -0.50 m
            -->
            <pose relative_to="payload_chassis_link">3.995 -0.568 -1.0 0 0 0</pose>
        </link>

        <!--
        x = payload_chassis.size_x/2 - front_wheel.radius - offset = 12.19/2 - 0.50 - 1 = 4.595 m
        y = payload_chassis.size_y/2 - front_wheel.length/2 = 2.336/2 - 0.38/2 = 0.978 m
        z = -front_wheel.radius = -0.50 m
        -->
        <joint name="front_right_landing_leg_joint" type="fixed">
            <parent>payload_chassis_link</parent>
            <child>front_right_landing_leg_link</child>
            <pose relative_to="payload_chassis_link">3.995 -0.568 -1.0 0 0 0</pose>
        </joint>

        <link name="rear_left_wheel_link">
            <visual name="visual">
                <geometry>
                    <cylinder>
                        <radius>0.50</radius>
                        <length>0.38</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0 0 0 1</ambient>
                    <diffuse>0 0 0 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
                <pose>0 0 0 1.5708 0 0</pose>
            </visual>

            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius>0.50</radius>
                        <length>0.38</length>
                    </cylinder>
                </geometry>
                <pose>0 0 0 1.5708 0 0</pose>
            </collision>

            <!--
            No need to use pose here, since we have used the inertia matrix of a wheel using the y-axis as the axis of
            rotation.
            <inertia ixx="${(1.0/12.0) * mass * (3.0 * radius * radius + thickness * thickness)}" ixy="0.0" ixz="0.0"
                    iyy="${(1.0/2.0) * mass * radius * radius}"
                    izz="${(1.0/12.0) * mass * (3.0 * radius * radius + thickness * thickness)}" iyz="0.0"/>
            -->
            <inertial>
                <mass>120.0</mass>
                <inertia>
                    <ixx>8.944</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>15.0</iyy>
                    <iyz>0.0</iyz>
                    <izz>8.944</izz>
                </inertia>
            </inertial>

            <!--
            x = -payload_chassis.size_x/2 + front_wheel.radius + offset_x = -12.19/2 + 0.50 + 1 = -4.595 m
            y = payload_chassis.size_y/2 - front_wheel.length/2 = 2.336/2 - 0.38/2 = 0.978 m
            z = -front_wheel.radius = -0.50 m
            -->
            <pose relative_to="payload_chassis_link">-4.595 0.978 -0.5 0 0 0</pose>
        </link>

        <!--
        x = -payload_chassis.size_x/2 + front_wheel.radius + offset = -12.19/2 + 0.50 + 1 = -4.595 m
        y = payload_chassis.size_y/2 - front_wheel.length/2 = 2.336/2 - 0.38/2 = 0.978 m
        z = -front_wheel.radius = -0.50 m
        -->
        <joint name="rear_left_wheel_joint" type="fixed">
            <parent>payload_chassis_link</parent>
            <child>rear_left_wheel_link</child>
            <pose relative_to="payload_chassis_link">-4.595 0.978 -0.5 0 0 0</pose>
        </joint>

        <link name="rear_right_wheel_link">
            <visual name="visual">
                <geometry>
                    <cylinder>
                        <radius>0.50</radius>
                        <length>0.38</length>
                    </cylinder>
                </geometry>
                <material>
                    <ambient>0 0 0 1</ambient>
                    <diffuse>0 0 0 1</diffuse>
                    <specular>0.1 0.1 0.1 1</specular>
                </material>
                <pose>0 0 0 1.5708 0 0</pose>
            </visual>

            <collision name="collision">
                <geometry>
                    <cylinder>
                        <radius>0.50</radius>
                        <length>0.38</length>
                    </cylinder>
                </geometry>
                <pose>0 0 0 1.5708 0 0</pose>
            </collision>

            <!--
            No need to use pose here, since we have used the inertia matrix of a wheel using the y-axis as the axis of
            rotation.
            <inertia ixx="${(1.0/12.0) * mass * (3.0 * radius * radius + thickness * thickness)}" ixy="0.0" ixz="0.0"
                    iyy="${(1.0/2.0) * mass * radius * radius}"
                    izz="${(1.0/12.0) * mass * (3.0 * radius * radius + thickness * thickness)}" iyz="0.0"/>
            -->
            <inertial>
                <mass>120.0</mass>
                <inertia>
                    <ixx>8.944</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>15.0</iyy>
                    <iyz>0.0</iyz>
                    <izz>8.944</izz>
                </inertia>
            </inertial>

            <!--
            x = -payload_chassis.size_x/2 + front_wheel.radius + offset_x = -12.19/2 + 0.50 + 1 = -4.595 m
            y = -payload_chassis.size_y/2 + front_wheel.length/2 = -2.336/2 + 0.38/2 = -0.978 m
            z = -front_wheel.radius = -0.50 m
            -->
            <pose relative_to="payload_chassis_link">-4.595 -0.978 -0.5 0 0 0</pose>
        </link>

        <!--
        x = -payload_chassis.size_x/2 + front_wheel.radius + offset = -12.19/2 + 0.50 + 1 = -4.595 m
        y = -payload_chassis.size_y/2 + front_wheel.length/2 = -2.336/2 + 0.38/2 = -0.978 m
        z = front_wheel.radius = 0.50 m
        -->
        <joint name="rear_right_wheel_joint" type="fixed">
            <parent>payload_chassis_link</parent>
            <child>rear_right_wheel_link</child>
            <pose relative_to="payload_chassis_link">-4.595 -0.978 -0.5 0 0 0</pose>
        </joint>
    </model>
</sdf>