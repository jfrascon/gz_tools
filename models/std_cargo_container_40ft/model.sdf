<?xml version="1.0"?>
<sdf version="1.7">
    <!--
    Outer dimensions of a standard 40ft cargo container are:
    size_x_outer = 12.19 m
    size_y_outer =  2.44 m
    size_z_outer =  2.59 m
    Reference: https://www.icontainers.com/help/40-foot-container/

    Inner dimensions:
    size_x_inner = 12.01 m
    size_y_inner =  2.33 m
    size_z_inner =  2.38 m
    Reference: Document from Schreder.

    diff_x = size_x_outer - size_x_inner = 0.18 m,
    diff_y = size_y_outer - size_y_inner = 0.11 m,
    diff_z = size_z_outer - size_z_inner = 0.21 m.

    Frame for the model is container_link, located at the center of bottom face of the container.
    -->
    <model name="std_cargo_container_40ft" canonical_link="container_link" placement_frame="container_link">
        <static>false</static>
        <self_collide>false</self_collide>

        <!--
        The container_link is at the center of the bottom face of the container.
        -->
        <link name="container_link">
            <visual name="floor_visual">
                <geometry>
                    <box>
                        <!--
                        sx = size_x_outer = 12.19 m
                        sy = size_y_outer = 2.44 m
                        sz = 0.005 m
                        -->
                        <size>12.19 2.44 0.005</size>
                    </box>
                </geometry>
                <!--
                pz = sz * 0.5 = 0.005 * 0.5 = 0.0025 m
                -->
                <pose>0 0 0.0025 0 0 0</pose>
                <material>
                    <ambient>0.9 1.0 0.3 1</ambient>
                    <diffuse>0.9 1.0 0.3 1</diffuse>
                    <specular>0.3 0.3 0.1 1</specular>
                </material>
            </visual>

            <visual name="left_wall_visual">
                <geometry>
                    <box>
                        <!--
                        sx = size_x_outer = 12.19 m
                        sy = diff_y * 0.5 = 0.11 * 0.5 = 0.055 m
                        sz = size_z_inner = 2.38 m
                        -->
                        <size>12.19 0.055 2.38</size>
                    </box>
                </geometry>
                <!--
                py = (size_y_outer * 0.5) - (sy * 0.5) =
                   = 0.5 * (size_y_outer - sy) =
                   = 0.5 * (2.44 - 0.055) = 1.1925 m
                pz = sz_floor + (0.5 * sz) =
                   = 0.005 + (0.5 * 2.38) = 1.195 m
                -->
                <pose>0 1.1925 1.195 0 0 0</pose>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>

            <visual name="right_wall_visual">
                <geometry>
                    <!--
                    sx = size_x_outer = 12.19 m
                    sy = diff_y * 0.5 = 0.11 * 0.5 = 0.055 m
                    sz = size_z_inner = 2.38 m
                    -->
                    <box>
                        <size>12.19 0.055 2.38</size>
                    </box>
                </geometry>
                <!--
                py = -(sy_outer * 0.5) + (sy * 0.5) =
                   = 0.5 * (-sy_outer + sy) =
                   = 0.5 * (-2.44 + 0.055) = -1.1925
                pz = sz_floor + (0.5 * sz) =
                   = 0.005 + (0.5 * 2.38) = 1.195 m
                -->
                <pose>0 -1.1925 1.195 0 0 0</pose>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>

            <visual name="ceiling_visual">
                <geometry>
                    <!--
                    sx = size_x_outer = 12.19 m
                    sy = size_y_outer = 2.44 m
                    sz = diff_z - 0.005 = 0.21 - 0.005 = 0.205 m
                    -->
                    <box>
                        <size>12.19 2.44 0.205</size>
                    </box>
                </geometry>
                <!--
                pz = sz_floor + sz_wall + (sz * 0.5)  =
                   = 0.005 + 2.38 + (0.205 * 0.5) = 2.4875
                -->
                <pose>0 0 2.4875 0 0 0</pose>
                <material>
                    <ambient>1 0 0 0.3</ambient>
                    <diffuse>1 0 0 0.3</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>

            <visual name="front_wall_visual">
                <geometry>
                    <!--
                    sx = diff_x * 0.5 = 0.18 * 0.5 = 0.09 m
                    sy = size_y_inner = 2.33 m
                    sz = size_z_inner = 2.38 m
                    -->
                    <box>
                        <size>0.09 2.33 2.38</size>
                    </box>
                </geometry>
                <!--
                px = (0.5 * sx_floor)  - (0.5 * sx) =
                   = 0.5 * (sx_floor - sx) =
                   = 0.5 * (12.19 - 0.09) = 6.05 m
                pz = sz_floor + (0.5 * sz) =
                   = 0.005 + (0.5 * 2.38) = 1.195 m
                -->
                <pose>6.050 0 1.195 0 0 0</pose>
                <material>
                    <ambient>1 0 0 1</ambient>
                    <diffuse>1 0 0 1</diffuse>
                    <specular>0.2 0.2 0.2 1</specular>
                </material>
            </visual>

            <collision name="floor_collision">
                <geometry>
                    <box>
                        <size>12.19 2.44 0.005</size>
                    </box>
                </geometry>
                <pose>0 0 0.0025 0 0 0</pose>
            </collision>

            <collision name="left_wall_collision">
                <geometry>
                    <box>
                        <size>12.19 0.055 2.38</size>
                    </box>
                </geometry>
                <pose>0 1.1925 1.195 0 0 0</pose>
            </collision>

            <collision name="right_wall_collision">
                <geometry>
                    <box>
                        <size>12.19 0.055 2.38</size>
                    </box>
                </geometry>
                <pose>0 -1.1925 1.195 0 0 0</pose>
            </collision>

            <collision name="ceiling_collision">
                <geometry>
                    <box>
                        <size>12.19 2.44 0.205</size>
                    </box>
                </geometry>
                <pose>0 0 2.4875 0 0 0</pose>
            </collision>

            <collision name="front_wall_collision">
                <geometry>
                    <box>
                        <size>0.09 2.33 2.38</size>
                    </box>
                </geometry>
                <pose>6.050 0 1.195 0 0 0</pose>
            </collision>

            <inertial>
                <mass>3701.0</mass>
                <inertia>
                    <ixx>3905.079308</ixx>
                    <ixy>0.0</ixy>
                    <ixz>0.0</ixz>
                    <iyy>47898.403683</iyy>
                    <iyz>0.0</iyz>
                    <izz>47665.703308</izz>
                </inertia>
                <pose>0 0 1.195 0 0 0</pose>
            </inertial>
            <pose>0 0 0 0 0 0</pose>
        </link>
    </model>
</sdf>
