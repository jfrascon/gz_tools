#!/usr/bin/env bash

# Use this script to delete one Gazebo Sim entity through the /gzserver/delete_entity ROS 2
# service when you know the exact entity name in the running simulation.
# Run it with the entity name:
#
#   delete_gz_entity <entity_name>
#
# The entity name must match the name registered in Gazebo. The script sends that name to the
# Gazebo delete service and does not remove files from disk.
#
# Example for deleting an entity previously spawned from
# src/0_deps/ros_gz_tools/models/euro_pallet/model.sdf:
#
#   delete_gz_entity euro_pallet_01

usage() {
  echo "Usage: ${0} <entity_name>"
}

for arg in "${@}"; do
  if [[ "${arg}" == "-h" || "${arg}" == "--help" ]]; then
    usage
    exit 0
  fi
done

if [[ ${#} -ne 1 ]]; then
  usage >&2
  exit 2
fi

entity_name="${1}"

ros2 service call /gzserver/delete_entity simulation_interfaces/srv/DeleteEntity "{
  entity: '${entity_name}'
}"
