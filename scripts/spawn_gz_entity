#!/usr/bin/env bash

usage() {
  echo "Usage: ${0} <uri> <name> <x_m> <y_m> <z_m> <roll_deg> <pitch_deg> <yaw_deg>"
}

# Position arguments are meters. Roll, pitch, and yaw arguments are degrees.
for arg in "${@}"; do
  if [[ "${arg}" == "-h" || "${arg}" == "--help" ]]; then
    usage
    exit 0
  fi
done

if [[ ${#} -ne 8 ]]; then
  usage >&2
  exit 2
fi

model_uri="${1}"
name="${2}"
pos_x_m="${3}"
pos_y_m="${4}"
pos_z_m="${5}"
roll_deg="${6}"
pitch_deg="${7}"
yaw_deg="${8}"

if [[ ! -f "${model_uri}" ]]; then
  echo "Error: model file does not exist: ${model_uri}" >&2
  exit 1
fi

read -r qx qy qz qw < <(
  python3 - "${pos_x_m}" "${pos_y_m}" "${pos_z_m}" "${roll_deg}" "${pitch_deg}" "${yaw_deg}" <<'PY'
import math
import sys

try:
    float(sys.argv[1])
    float(sys.argv[2])
    float(sys.argv[3])
    roll = math.radians(float(sys.argv[4]))
    pitch = math.radians(float(sys.argv[5]))
    yaw = math.radians(float(sys.argv[6]))
except ValueError as exc:
    raise SystemExit(f"x_m, y_m, z_m, roll_deg, pitch_deg and yaw_deg must be numeric: {exc}")

cr = math.cos(roll / 2.0)
sr = math.sin(roll / 2.0)
cp = math.cos(pitch / 2.0)
sp = math.sin(pitch / 2.0)
cy = math.cos(yaw / 2.0)
sy = math.sin(yaw / 2.0)

qx = sr * cp * cy - cr * sp * sy
qy = cr * sp * cy + sr * cp * sy
qz = cr * cp * sy - sr * sp * cy
qw = cr * cp * cy + sr * sp * sy

print(qx, qy, qz, qw)
PY
)

ros2 service call /gzserver/spawn_entity simulation_interfaces/srv/SpawnEntity "{
  name: '${name}',
  allow_renaming: false,
  uri: '${model_uri}',
  resource_string: '',
  entity_namespace: '',
  initial_pose: {
    header: {frame_id: 'world'},
    pose: {
      position: {x: ${pos_x_m}, y: ${pos_y_m}, z: ${pos_z_m}},
      orientation: {x: ${qx}, y: ${qy}, z: ${qz}, w: ${qw}}
    }
  }
}"
