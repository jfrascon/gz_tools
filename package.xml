<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
    <name>eut_gz_models</name>
    <version>1.0.0</version>
    <description>A package containing simulation models, worlds, and other assets for Gazebo.</description>
    <maintainer email="juan.rascon@eurecat.org">Juan Fco Rascon</maintainer>
    <license>Apache-2.0</license>

    <buildtool_depend>ament_cmake</buildtool_depend>
    <buildtool_depend>ament_cmake_python</buildtool_depend>

    <exec_depend>ament_index_python</exec_depend>
    <exec_depend>launch</exec_depend>
    <exec_depend>launch_ros</exec_depend>
    <exec_depend>python3-catkin-pkg</exec_depend>
    <exec_depend>rclcpp_components</exec_depend>
    <exec_depend>ros2pkg</exec_depend>
    <exec_depend>ros_gz_bridge</exec_depend>
    <exec_depend>ros_gz_sim</exec_depend>
    <exec_depend>rosgraph_msgs</exec_depend>

    <test_depend>ament_lint_auto</test_depend>
    <test_depend>ament_lint_common</test_depend>

    <export>
        <build_type>ament_cmake</build_type>
        <!--
        See function 'get_paths' in file
        https://github.com/gazebosim/ros_gz/blob/ros2/ros_gz_sim/ros_gz_sim/actions/gzserver.py
        or function 'get_paths' in file
        https://github.com/gazebosim/ros_gz/blob/ros2/ros_gz_sim/launch/gz_sim.launch.py.in
        for details about the tag 'gazebo_ros' and its attributes.
        -->
        <gazebo_ros gazebo_model_path="${prefix}/models"/>
        <gazebo_ros gazebo_model_path="${prefix}/worlds"/>
        <!--
        <gazebo_ros gazebo_media_path="<path/to/media_resources>"/>
        <gazebo_ros plugin_path="<path/to/plugins>"/>
        -->
    </export>
</package>
